    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst sorted = items\n  .filter(i => (i.json.isoDate || i.json.pubDate) && i.json.enclosure?.url)\n  .sort((a, b) => {\n    const dateA = new Date(a.json.isoDate ?? a.json.pubDate).getTime();\n    const dateB = new Date(b.json.isoDate ?? b.json.pubDate).getTime();\n    return dateB - dateA;\n  });\n\n// Уникальный hash из execution ID\nconst execId = $execution.id ?? String(Date.now());\nconst hash = execId.split('').reduce((acc, c) => acc + c.charCodeAt(0), 0);\nconst index = hash % Math.min(sorted.length, 50);\n\nconst item = (sorted[index] ?? sorted[0]).json;\n\nconst hour = new Date().getHours();\nconst angle = \n  hour < 10 ? 'обзор главных новостей электромобильного рынка' :\n  hour < 14 ? 'глубокий технический разбор — характеристики, батарея, запас хода' :\n  hour < 18 ? 'анализ рынка — цены, продажи, тренды' :\n  'инфраструктура зарядки — сети, скорость, доступность';\n\nconst title = (item.title ?? '').replace(/[^\\w\\s]/gi, '').trim().slice(0, 60);\n\n\n\nreturn [{\n  json: {\n    query: title ? `${title} 2025` : 'electric vehicle news 2025',\n    title: item.title ?? '',\n    link: item.link ?? item.guid ?? '',\n    pubDate: item.pubDate ?? item.isoDate,\n    image: item.enclosure?.url ?? '',\n    content: item.content ?? item.contentSnippet ?? '',\n    angle: angle,\n    index\n  }\n}];"
      },
