        "jsCode": "const html = $input.first().json.data ?? '';\nconst rssItem = $('Limit: Top 1').first().json;\n\nconst text = html\n  .replace(/<script[^>]*>[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[^>]*>[\\s\\S]*?<\\/style>/gi, '')\n  .replace(/<[^>]+>/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim()\n  .slice(0, 3000);\n\n\n\nreturn [{\n  json: {\n    title: rssItem.title,\n    link: rssItem.link,\n    image: rssItem.enclosure?.url ?? '',\n    content: text\n  }\n}];"
      },
