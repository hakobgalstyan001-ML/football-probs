    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst raw = input.output ?? input.text ?? input.content ?? '';\n\nif (!raw) {\n  return [{ json: { raw_text: '' } }];\n}\n\nconst cleaned = raw.replace(/```json/gi, '').replace(/```/gi, '').trim();\n\nlet result = cleaned;\nif (cleaned.length > 1024) {\n  const cut = cleaned.slice(0, 980);\n  const lastDot = Math.max(\n    cut.lastIndexOf('. '),\n    cut.lastIndexOf('.\\n'),\n    cut.lastIndexOf('!\\n'),\n    cut.lastIndexOf('?\\n')\n  );\n  result = lastDot > 0 ? cleaned.slice(0, lastDot + 1) : cut;\n}\n\nreturn [{ json: { raw_text: result } }];"
      },
